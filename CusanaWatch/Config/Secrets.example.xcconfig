// TEMPLATE — copy this file to `Secrets.xcconfig` in the same folder, then
// paste the real values in. `Secrets.xcconfig` is gitignored. This file is not.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Where the token comes from: log into the Cusana web app as the demo diner,
// open the browser console, and read
//
//     localStorage.getItem('base44_access_token')
//
// It is a ~744-character JWT and it is a live credential. It goes here and
// nowhere else — never in a Swift file, never in a commit, never pasted into
// the Upwork thread or a chat. Token lifetime is 90 days.
//
// Verify before your first commit:
//     git status --porcelain | grep Secrets.xcconfig   # must print nothing

CUSANA_TOKEN = PASTE_THE_JWT_HERE

// Only needed to run on a physical Apple Watch. Find it in Xcode →
// Settings → Accounts → Manage Certificates, or on developer.apple.com.
// Leave blank for simulator-only work.
CUSANA_DEVELOPMENT_TEAM =
